{
  "name": "habit-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "server": "cd server && npm start",
    "dev": "vite --host --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "lint": "eslint .",
    "preview": "vite preview --config vite.config.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "mongoose": "^9.6.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
